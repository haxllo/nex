<Project Sdk="WixToolset.Sdk/6.0.2">
  <PropertyGroup>
    <OutputType>Bundle</OutputType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <OutputPath>$(MSBuildThisFileDirectory)..\..\artifacts\windows\</OutputPath>
    <AppVersion Condition="'$(AppVersion)' == ''">0.0.0-local</AppVersion>
    <StageDir Condition="'$(StageDir)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\windows\nex-$(AppVersion)-windows-x64-stage</StageDir>
    <MsiPath Condition="'$(MsiPath)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\windows\nex-$(AppVersion)-windows-x64.msi</MsiPath>
    <DefineConstants>AppVersion=$(AppVersion);StageDir=$(StageDir);MsiPath=$(MsiPath)</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.Bal.wixext" Version="6.0.2" />
    <Compile Include="Bundle.wxs" />
  </ItemGroup>
</Project>
