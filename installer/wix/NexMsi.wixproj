<Project Sdk="WixToolset.Sdk/7.0.0">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <InstallerPlatform>x64</InstallerPlatform>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <OutputPath>$(MSBuildThisFileDirectory)..\..\artifacts\windows\</OutputPath>
    <AppVersion Condition="'$(AppVersion)' == ''">0.0.0-local</AppVersion>
    <StageDir Condition="'$(StageDir)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\windows\nex-$(AppVersion)-windows-x64-stage</StageDir>
    <DefineConstants>AppVersion=$(AppVersion);StageDir=$(StageDir)</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.Util.wixext" Version="7.0.0" />
    <Compile Include="Product.wxs" />
  </ItemGroup>
</Project>
